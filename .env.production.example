# Copy to .env.production, fill every value, then chmod 600 .env.production.
# Never commit .env.production, TLS private keys, or database backups.
POSTGRES_DB=security_monitor
POSTGRES_USER=security_monitor
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql+psycopg://security_monitor:replace-with-a-random-password@db:5432/security_monitor
LOG_LEVEL=INFO

# Production must require administrator authentication.
AUTH_REQUIRED=true
ADMIN_USERNAME=replace-with-admin-username
# Generate with scripts/hash-admin-password.py; single-quote the resulting value in .env.production.
ADMIN_PASSWORD_HASH=replace-with-pbkdf2-password-hash
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-random-session-secret
ADMIN_SESSION_TTL_MINUTES=60
# Per source IP. Login rate-limit hits are written to the audit log.
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10

DOMAIN=monitor.example.com
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_FILE=/etc/letsencrypt/live/monitor.example.com/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/monitor.example.com/privkey.pem
# Pydantic JSON list; never use "*" with credentialed requests.
CORS_ORIGINS=["https://monitor.example.com"]

COLLECTOR_CREDENTIAL_TTL_DAYS=365
COLLECTOR_MAX_BATCH_SIZE=500
COLLECTOR_MAX_BODY_BYTES=2000000
COLLECTOR_MAX_CLOCK_SKEW_SECONDS=900
COLLECTOR_MAX_EVENT_AGE_SECONDS=604800
COLLECTOR_RATE_LIMIT_PER_MINUTE=120
COLLECTOR_OFFLINE_AFTER_SECONDS=90
