# Copy to .env.production, fill every value, then chmod 600 .env.production.
# Never commit .env.production, TLS private keys, or database backups.
POSTGRES_DB=security_monitor
POSTGRES_USER=security_monitor
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql+psycopg://security_monitor:replace-with-a-random-password@db:5432/security_monitor
LOG_LEVEL=INFO
DOMAIN=monitor.example.com
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_FILE=/etc/letsencrypt/live/monitor.example.com/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/monitor.example.com/privkey.pem
