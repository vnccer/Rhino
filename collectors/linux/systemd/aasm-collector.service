[Unit]
Description=AI-Agent Security Monitor Linux Collector
Documentation=file:/opt/aasm-collector/README.md
After=network-online.target auditd.service
Wants=network-online.target

[Service]
Type=simple
User=aasm-collector
Group=aasm-collector
SupplementaryGroups=adm
WorkingDirectory=/opt/aasm-collector
Environment=PYTHONPATH=/opt/aasm-collector
Environment=AASM_LOG_LEVEL=INFO
ExecStart=/usr/bin/python3 -m aasm_linux_collector --config /etc/aasm-collector/config.ini run
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/etc/aasm-collector /var/log/audit
ReadOnlyPaths=-/var/log/auth.log
ReadWritePaths=/var/lib/aasm-collector
UMask=0077

[Install]
WantedBy=multi-user.target
